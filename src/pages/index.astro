---
// Thalermark marketing landing page.
// Ported from thalermark/spikes/thalermark-landing.html with the beta-launch
// CTA changes: email waitlist → live app links (sign-up is open).
const APP = 'https://app.thalermark.com';
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- Primary Meta -->
<title>Thalermark: Accounting for the people who build, mend, and tend.</title>
<meta name="description" content="An open source accounting tool for freelancers and trades people. Less paperwork, more answers.">
<meta name="theme-color" content="#0f1626">

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png">
<link rel="manifest" href="/site.webmanifest">

<!-- Open Graph (Facebook, LinkedIn, Slack, Discord) -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://thalermark.com/">
<meta property="og:title" content="Thalermark: Accounting for the people who build, mend, and tend.">
<meta property="og:description" content="An open source accounting tool for freelancers and trades people. Less paperwork, more answers.">
<meta property="og:image" content="https://thalermark.com/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Thalermark: the mark of the Thaler">
<meta property="og:site_name" content="Thalermark">
<meta property="og:locale" content="en_US">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content="https://thalermark.com/">
<meta name="twitter:title" content="Thalermark: Accounting for the people who build, mend, and tend.">
<meta name="twitter:description" content="An open source accounting tool for freelancers and trades people. Less paperwork, more answers.">
<meta name="twitter:image" content="https://thalermark.com/og-image.png">
<meta name="twitter:image:alt" content="Thalermark: the mark of the Thaler">

<!-- Structured data for richer Google results -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Thalermark",
  "description": "An open source accounting tool for freelancers and trades people. Less paperwork, more answers.",
  "url": "https://thalermark.com",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "iOS, Android, Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
  :root {
    --gold: #c8a663;
    --gold-deep: #9a7d3f;
    --gold-light: #e8d5a3;
    --navy: #1a2238;
    --navy-deep: #0f1626;
    --ink: #0f1626;
    --cream: #f4ede0;
    --cream-warm: #ebe0cc;
    --sage: #5c7b3f;
    --copper: #b87333;
    --slate: #3d5a6c;
    --oxblood: #8b3a2e;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--cream);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* Grain overlay for warmth */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.035;
    z-index: 100;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  /* === Reusable === */
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-deep);
    display: inline-block;
  }

  .eyebrow::before {
    content: '';
    display: inline-block;
    width: 1.1em;
    height: 1.5px;
    background: var(--gold);
    margin-right: 0.5em;
    vertical-align: 0.22em;
  }

  /* === Struck Mark Wordmark Component === */
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    position: relative;
  }

  .wordmark .strike {
    display: block;
    height: 1.5px;
    background: currentColor;
    width: 100%;
    margin-bottom: 0.15em;
    position: relative;
  }

  .wordmark .strike::before,
  .wordmark .strike::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  .wordmark .strike::before { left: 0; }
  .wordmark .strike::after { right: 0; }

  .wordmark .word {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    letter-spacing: -0.04em;
    font-variation-settings: 'opsz' 144;
  }

  .wordmark-large .word { font-size: clamp(3rem, 8vw, 6rem); }
  .wordmark-medium .word { font-size: 2.2rem; }
  .wordmark-small .word { font-size: 1.4rem; }

  /* === Nav === */
  nav {
    padding: 2rem 0;
    position: relative;
    z-index: 10;
  }

  nav .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  nav .wordmark {
    color: var(--ink);
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 2.5rem;
    align-items: center;
  }

  nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  nav a:hover { color: var(--gold-deep); }

  nav .cta {
    background: var(--ink);
    color: var(--cream);
    padding: 0.7rem 1.4rem;
    border-radius: 2px;
    font-size: 0.85rem;
    transition: background 0.2s;
  }

  nav .cta:hover { background: var(--navy); color: var(--cream); }

  .nav-github {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.2s, color 0.2s;
  }

  .nav-github:hover {
    opacity: 1;
    color: var(--gold-deep);
  }

  .nav-github svg {
    display: block;
  }

  /* === Hero === */
  .hero {
    padding: 6rem 0 8rem;
    position: relative;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .hero h1 {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
    font-variation-settings: 'opsz' 144;
    margin: 2rem 0;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--gold-deep);
    font-weight: 400;
  }

  .hero p.lead {
    font-size: 1.15rem;
    color: var(--ink);
    opacity: 0.75;
    line-height: 1.6;
    max-width: 480px;
    margin-bottom: 2.5rem;
  }

  /* === CTA buttons (replaces the early-access email form) === */
  .cta-row {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .btn-primary {
    display: inline-block;
    background: var(--ink);
    color: var(--cream);
    padding: 1rem 2.2rem;
    border-radius: 2px;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: background 0.2s;
  }

  .btn-primary:hover { background: var(--gold-deep); color: var(--cream); }

  .btn-secondary {
    color: var(--ink);
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    border-bottom: 1px solid var(--gold-deep);
    transition: color 0.2s, border-color 0.2s;
  }

  .btn-secondary:hover { color: var(--gold-deep); }

  .form-note {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--ink);
    opacity: 0.5;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.05em;
  }

  .form-note .mail-link {
    color: var(--gold-deep);
    text-decoration: none;
    border-bottom: 1px solid var(--gold-deep);
    transition: color 0.2s, border-color 0.2s;
    opacity: 1;
  }

  .form-note .mail-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .cta-section .form-note {
    color: var(--ink);
    opacity: 0.6;
  }

  /* Hero visual: large struck mark */
  .hero-visual {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-mark {
    width: 100%;
    max-width: 460px;
    position: relative;
    color: var(--gold-deep);
  }

  .hero-mark::before {
    content: '';
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle, rgba(200, 166, 99, 0.08) 0%, transparent 60%);
    z-index: -1;
  }

  /* Decorative dentil ring around hero mark */
  .dentils {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* === Section: Quote of the customer === */
  .interlude {
    background: var(--navy);
    color: var(--cream);
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }

  .interlude::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top, rgba(200, 166, 99, 0.08), transparent 70%);
    pointer-events: none;
  }

  .interlude blockquote {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    max-width: 820px;
    color: var(--cream);
    font-variation-settings: 'opsz' 144;
    position: relative;
    padding-left: 2rem;
    border-left: 2px solid var(--gold);
  }

  .interlude blockquote em {
    color: var(--gold-light);
    font-style: italic;
  }

  .interlude .attribution {
    margin-top: 2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    padding-left: 2rem;
  }

  /* === Section: How it differs === */
  .difference {
    padding: 8rem 0;
  }

  .section-header {
    margin-bottom: 5rem;
    max-width: 720px;
  }

  .section-header h2 {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 1rem 0;
    font-variation-settings: 'opsz' 144;
  }

  .section-header h2 em {
    color: var(--gold-deep);
    font-style: italic;
  }

  .section-header p {
    font-size: 1.1rem;
    color: var(--ink);
    opacity: 0.7;
    line-height: 1.6;
  }

  .comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid rgba(15, 22, 38, 0.12);
    border-radius: 4px;
    overflow: hidden;
  }

  .comparison > div {
    padding: 2.5rem;
    position: relative;
  }

  .comparison .old {
    background: var(--cream-warm);
    color: var(--ink);
    opacity: 0.75;
  }

  .comparison .new {
    background: var(--ink);
    color: var(--cream);
  }

  .comparison .label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    opacity: 0.6;
  }

  .comparison .new .label { color: var(--gold); opacity: 1; }

  .comparison .quote {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: 1.45rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 144;
  }

  .comparison .new .quote em {
    color: var(--gold-light);
    font-style: italic;
  }

  /* === Section: Features === */
  .features {
    padding: 6rem 0;
    background: var(--cream-warm);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 4rem;
  }

  .feature {
    padding: 3rem 2.5rem;
    border-right: 1px solid rgba(15, 22, 38, 0.1);
    border-bottom: 1px solid rgba(15, 22, 38, 0.1);
    position: relative;
    transition: background 0.3s;
  }

  .feature:hover { background: rgba(200, 166, 99, 0.08); }

  .feature:nth-child(2n) { border-right: none; }
  .feature:nth-last-child(-n+2) { border-bottom: none; }

  .feature .num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--gold-deep);
    margin-bottom: 1rem;
    display: block;
  }

  .feature h3 {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 1rem;
    font-variation-settings: 'opsz' 36;
  }

  .feature p {
    font-size: 0.95rem;
    color: var(--ink);
    opacity: 0.7;
    line-height: 1.6;
  }

  /* === Section: For who === */
  .audience {
    padding: 8rem 0;
  }

  .audience-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: 4rem;
  }

  .audience-item {
    text-align: center;
    padding: 2rem 1rem;
    border-top: 2px solid var(--gold);
    transition: transform 0.3s;
  }

  .audience-item:hover { transform: translateY(-4px); }

  .audience-item .icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 1.5rem;
    color: var(--gold-deep);
  }

  .audience-item h4 {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: 1.2rem;
    color: var(--ink);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .audience-item p {
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.6;
  }

  /* === Section: Open Source === */
  .principles {
    background: var(--navy);
    color: var(--cream);
    padding: 8rem 0;
    position: relative;
    overflow: hidden;
  }

  .principles::before {
    content: '';
    position: absolute;
    top: -200px;
    right: -200px;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(200, 166, 99, 0.06), transparent 60%);
    pointer-events: none;
  }

  .principles .section-header h2 { color: var(--cream); }
  .principles .section-header p { color: var(--cream); opacity: 0.7; }
  .principles .eyebrow { color: var(--gold); }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-top: 4rem;
  }

  .principle h3 {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: 1.4rem;
    margin: 1rem 0;
    color: var(--gold-light);
    letter-spacing: -0.01em;
  }

  .principle p {
    font-size: 0.95rem;
    color: var(--cream);
    opacity: 0.7;
    line-height: 1.6;
  }

  .principle .num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.8rem;
    color: var(--gold);
    font-weight: 400;
  }

  /* === Final CTA === */
  .cta-section {
    padding: 10rem 0;
    text-align: center;
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-warm) 100%);
  }

  .cta-section h2 {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--ink);
    max-width: 900px;
    margin: 1.5rem auto 2.5rem;
    font-variation-settings: 'opsz' 144;
  }

  .cta-section h2 em {
    color: var(--gold-deep);
    font-style: italic;
  }

  .cta-section .cta-row {
    justify-content: center;
  }

  /* === Footer === */
  footer {
    background: var(--navy-deep);
    color: var(--cream);
    padding: 5rem 0 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(244, 237, 224, 0.1);
  }

  .footer-brand .wordmark { color: var(--cream); margin-bottom: 1.5rem; }

  .footer-brand p {
    color: var(--cream);
    opacity: 0.6;
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 320px;
  }

  footer h5 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  footer ul { list-style: none; }
  footer li { margin-bottom: 0.75rem; }

  footer a {
    color: var(--cream);
    opacity: 0.75;
    text-decoration: none;
    font-size: 0.9rem;
    transition: opacity 0.2s, color 0.2s;
  }

  footer a:hover { opacity: 1; color: var(--gold-light); }

  .footer-bottom {
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--cream);
    opacity: 0.4;
  }

  .footer-bottom .meta { display: flex; gap: 2rem; flex-wrap: wrap; }

  /* === Animations === */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes strike {
    from { transform: scaleX(0); opacity: 0; }
    to { transform: scaleX(1); opacity: 1; }
  }

  .hero h1, .hero p.lead, .hero .cta-row, .hero .form-note, .hero .eyebrow {
    animation: fadeUp 0.8s ease backwards;
  }

  .hero .eyebrow { animation-delay: 0.1s; }
  .hero h1 { animation-delay: 0.2s; }
  .hero p.lead { animation-delay: 0.4s; }
  .hero .cta-row { animation-delay: 0.55s; }
  .hero .form-note { animation-delay: 0.7s; }

  .wordmark .strike {
    transform-origin: left;
    animation: strike 0.7s cubic-bezier(0.6, 0, 0.4, 1) backwards;
  }

  nav .wordmark .strike { animation-delay: 0.5s; }

  /* === Responsive === */
  @media (max-width: 900px) {
    .hero-grid, .comparison, .features-grid, .principles-grid {
      grid-template-columns: 1fr;
    }
    .audience-list { grid-template-columns: repeat(2, 1fr); }
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .hero { padding: 3rem 0 5rem; }
    .hero-visual { max-width: 380px; margin: 0 auto; }
    nav ul li:not(:last-child) { display: none; }
    .comparison .new, .comparison .old { padding: 2rem; }
    .feature { border-right: none !important; }
    .feature:not(:last-child) { border-bottom: 1px solid rgba(15, 22, 38, 0.1) !important; }
  }

  @media (max-width: 560px) {
    .audience-list { grid-template-columns: 1fr 1fr; }
    .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
    .container { padding: 0 1.25rem; }
    .cta-row { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .cta-section .cta-row { align-items: center; }
    .btn-primary { width: 100%; text-align: center; }
    .cta-section .btn-primary { width: auto; }
  }

</style>

<!-- Matomo -->
